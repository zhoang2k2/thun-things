# Thun Things environment contract. Copy to .env.local and fill in values.
# Every variable is optional until its phase; see docs/configuration-variables.md.

# P1 — public site URL (default http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# P3 — contact form email via Resend (form disabled when missing)
RESEND_API_KEY=
LEADS_TO_EMAIL=
# Default onboarding@resend.dev; switch to own domain at P9
LEADS_FROM_EMAIL=

# P3 — rate limiting via Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# P6 — GA4 measurement ID, format G-XXXXXXX (analytics off when missing)
NEXT_PUBLIC_GA_ID=

# P8 — quiz AI rationale (AI off unless AI_ENABLED=true).
# Gemini is tried first; Anthropic is the fallback. Set either key or both.
GEMINI_API_KEY=
# Default gemini-3.1-flash-lite (cheapest model for new keys)
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# Default claude-haiku-5-5
ANTHROPIC_MODEL=
AI_ENABLED=false
