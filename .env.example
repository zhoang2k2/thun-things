# ==============================================================================
# Thun Things — Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local, API keys, or production credentials to version control.
#
# NAMING CONVENTIONS:
# - Variables starting with NEXT_PUBLIC_ are exposed to the browser bundle.
# - All other variables are server-only and must NEVER be exposed to the client.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Future Phase: AI Integration (Phase 5 — Anthropic Claude)
# ------------------------------------------------------------------------------
# Server-only: API key for Anthropic Claude API (deterministic recommendations blurb)
ANTHROPIC_API_KEY=
# Model identifier (default: claude-3-7-sonnet-20250219)
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ------------------------------------------------------------------------------
# Future Phase: Lead Management & Notifications (Phase 3 — Resend)
# ------------------------------------------------------------------------------
# Server-only: Resend API key for delivering contact form submissions
RESEND_API_KEY=
# Destination mailbox where contact inquiries and waitlist notifications are sent
LEADS_TO_EMAIL=owner@example.com

# ------------------------------------------------------------------------------
# Future Phase: Rate Limiting & Abuse Prevention (Phase 4 / 5)
# ------------------------------------------------------------------------------
# Server-only: Redis connection details for API rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ------------------------------------------------------------------------------
# Client-Safe Variables (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Public: Google Analytics 4 Measurement ID (only loaded after explicit cookie consent)
NEXT_PUBLIC_GA_ID=
# Public: Canonical site URL for metadata and OpenGraph resolution
NEXT_PUBLIC_SITE_URL=http://localhost:3000
